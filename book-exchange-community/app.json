{
  "expo": {
    "jsEngine": "jsc",
    "name": "book-exchange-community",
    "slug": "book-exchange-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Swap-Books.png",
      "resizeMode": "contain",
      "backgroundColor": "#011F26"
    },
    "plugins": [
      "expo-dev-client",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte libros cercanos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#011F26"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.bookexchangecommunity",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c1622fe2-3cbf-4f17-98e9-bb284cec665d"
      }
    },
    "owner": "chop546"
  }
}
